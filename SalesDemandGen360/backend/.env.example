# Copy to .env and fill in. Never commit .env.
#
# Note the +psycopg driver — a plain postgresql:// URL is rejected at startup.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/sdg360

# Encrypts stored credentials. Changing it makes existing ones undecryptable.
SECRET_KEY=dev-only-change-me-in-production-32chars

ENVIRONMENT=local
DEBUG=true
DB_ECHO=false

# Optional until Phase 3.
# ANTHROPIC_API_KEY=sk-ant-...
