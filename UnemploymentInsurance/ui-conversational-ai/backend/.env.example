# GCP
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1

# Models
PLANNER_MODEL=gemini-2.5-pro
FLASH_MODEL=gemini-2.5-flash

# Vertex AI Search
VERTEX_SEARCH_DATA_STORE_POLICY=projects/PROJECT/locations/global/dataStores/ui-policy
VERTEX_SEARCH_DATA_STORE_QBANK=projects/PROJECT/locations/global/dataStores/ui-qbank
VERTEX_SEARCH_DATA_STORE_ALLOWLIST=projects/PROJECT/locations/global/dataStores/ui-allowlist

# DLP
DLP_INSPECT_TEMPLATE=projects/PROJECT/locations/us/inspectTemplates/ui-claimant-pii
DLP_DEIDENTIFY_TEMPLATE=projects/PROJECT/locations/us/deidentifyTemplates/ui-claimant-redact

# Document AI
DOC_AI_PROCESSOR_PAYSTUB=projects/PROJECT/locations/us/processors/PROCESSOR_ID
DOC_AI_PROCESSOR_SEPARATION=projects/PROJECT/locations/us/processors/PROCESSOR_ID

# Firestore (live session state)
FIRESTORE_DATABASE=(default)

# Cloud SQL Postgres (claims, decisions, audit, training_records)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ui_conv_ai

# Server
API_HOST=0.0.0.0
API_PORT=8003
LOG_LEVEL=INFO

# Confidence-band thresholds
CONF_AUTONOMOUS_MIN=0.90
CONF_ADJUDICATOR_MIN=0.65

# Per-conversation guard rails
MAX_TURNS_PER_CONVERSATION=20
MAX_PLANNER_STEPS_PER_TURN=4
TURN_DEADLINE_SECONDS=15

# Feature flags
AUTONOMOUS_BAND_ENABLED=false
SHADOW_DECISIONS_ENABLED=true
